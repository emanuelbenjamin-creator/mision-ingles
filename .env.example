# ── IA principal (recomendada) ──────────────────────────────────────────────
# Necesitas al menos una clave de IA: Gemini, Groq o Cerebras. Gemini es la única que da
# voz natural en la nube (TTS), Gemini Live y evaluación escuchando el audio.
# Clave de Gemini (https://aistudio.google.com/apikey). Para costo cero, créala en un
# proyecto SIN facturación activada: así solo se usa la capa gratuita.
GEMINI_API_KEY=

# ── Modelos (opcional; por defecto solo modelos con capa gratuita) ───────────
# Se lanzan todos a la vez y gana la primera respuesta válida.
GEMINI_MODELS=gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite
# Último respaldo si todos fallan (Gemma es gratis en la Gemini API).
GEMINI_FALLBACK_MODELS=gemma-3-27b-it
GEMINI_TTS_MODELS=gemini-3.8-flash-lite-tts,gemini-3.1-flash-tts-preview,gemini-2.5-flash-preview-tts
GEMINI_LIVE_MODELS=gemini-3.8-live,gemini-2.5-flash-native-audio-preview-12-2025

# ── Otros proveedores gratuitos (opcional; se suman a la carrera) ────────────
# Groq: https://console.groq.com/keys — muy rápido, capa gratuita sin tarjeta.
# Además activa Whisper (transcripción en servidor) y el modo de voz económico sin Web Speech.
GROQ_API_KEY=
# Cerebras: https://cloud.cerebras.ai — 1 millón de tokens/día gratis, sin tarjeta.
CEREBRAS_API_KEY=
# Respaldo si todos los anteriores fallan:
# Mistral: https://console.mistral.ai (plan Experiment gratis) · OpenRouter: https://openrouter.ai/keys (modelos «:free»)
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
# Modelos de cada proveedor (opcional; los que no existan para tu clave se descartan solos)
GROQ_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile,openai/gpt-oss-20b,llama-3.1-8b-instant
CEREBRAS_MODELS=gpt-oss-120b,llama-3.3-70b,qwen-3-32b,llama3.1-8b
MISTRAL_MODELS=mistral-small-latest
OPENROUTER_MODELS=openai/gpt-oss-20b:free,meta-llama/llama-3.3-70b-instruct:free,deepseek/deepseek-chat-v3-0324:free
# Whisper de Groq (2,000 audios/día gratis)
GROQ_STT_MODEL=whisper-large-v3-turbo

# ── Pronunciación por fonemas (opcional) ────────────────────────────────────
# Azure AI Speech, plan F0 gratis (5 h de audio al mes). Portal de Azure → crear recurso
# «Speech» con plan Free F0 → Keys and Endpoint. Si falta, se usa Gemini o Whisper.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# ── Acceso y límites (opcional) ─────────────────────────────────────────────
# Si lo defines, la app pide este código en Ajustes antes de usar la IA.
APP_ACCESS_CODE=
DAILY_LIMIT_PER_IP=80
TTS_DAILY_LIMIT_PER_IP=400
STT_DAILY_LIMIT_PER_IP=300
LIVE_SESSIONS_PER_DAY=6
LIVE_MAX_MINUTES=10
# Tarjetas en vivo durante la llamada (correcciones, palabras, retos). Pon 0 si tu modelo de
# Gemini Live no admite funciones y la llamada no conecta.
LIVE_CARDS=1

# ── Ligas y recordatorios (opcional) ────────────────────────────────────────
# Upstash Redis: Vercel → Storage → Marketplace → Upstash → Connect (las crea solas).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Claves VAPID para notificaciones: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
# Protege /api/cron-remind (Vercel Cron lo envía solo si está definido).
CRON_SECRET=
