# ── Obligatoria ─────────────────────────────────────────────────────────────
# Clave de Gemini (https://aistudio.google.com/apikey). Para costo cero, créala en un
# proyecto SIN facturación activada: así solo se usa la capa gratuita.
GEMINI_API_KEY=

# ── Modelos (opcional; por defecto solo modelos con capa gratuita) ───────────
# Se lanzan todos a la vez y gana la primera respuesta válida.
GEMINI_MODELS=gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite
# Último respaldo si todos fallan (Gemma es gratis en la Gemini API).
GEMINI_FALLBACK_MODELS=gemma-3-27b-it
GEMINI_TTS_MODELS=gemini-3.8-flash-lite-tts,gemini-3.1-flash-tts-preview,gemini-2.5-flash-preview-tts
GEMINI_LIVE_MODELS=gemini-3.8-live,gemini-2.5-flash-native-audio-preview-12-2025

# ── Acceso y límites (opcional) ─────────────────────────────────────────────
# Si lo defines, la app pide este código en Ajustes antes de usar la IA.
APP_ACCESS_CODE=
DAILY_LIMIT_PER_IP=80
TTS_DAILY_LIMIT_PER_IP=400
LIVE_SESSIONS_PER_DAY=6
LIVE_MAX_MINUTES=10

# ── Ligas y recordatorios (opcional) ────────────────────────────────────────
# Upstash Redis: Vercel → Storage → Marketplace → Upstash → Connect (las crea solas).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Claves VAPID para notificaciones: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
# Protege /api/cron-remind (Vercel Cron lo envía solo si está definido).
CRON_SECRET=
