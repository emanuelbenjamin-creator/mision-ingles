# Clave de Gemini (https://aistudio.google.com/apikey). Solo en el servidor (Vercel → Settings → Environment Variables).
GEMINI_API_KEY=

# Opcional: cadena de modelos a probar en orden (si uno falla o está saturado, pasa al siguiente).
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite

# Opcional: si lo defines, la app pide este código en Ajustes antes de usar el coach IA.
APP_ACCESS_CODE=

# Opcional: consultas al coach por IP y por día (freno de costos).
DAILY_LIMIT_PER_IP=80
